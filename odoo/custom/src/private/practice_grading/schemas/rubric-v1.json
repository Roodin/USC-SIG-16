{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usc.es/odoo/practice-grading/rubric-v1.json",
  "title": "Practice Grading Rubric v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "criteria"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string"
    },
    "evaluation_scope": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "pass_score": {
      "type": "number",
      "minimum": 0
    },
    "total_weight": {
      "type": "number",
      "minimum": 0
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "weight", "mode"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mode": {
          "enum": ["automatic", "manual"]
        },
        "verifier": {
          "$ref": "#/$defs/verifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "automatic"
              }
            }
          },
          "then": {
            "required": ["verifier"]
          }
        }
      ]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["record_exists", "record_count", "field_equals"]
        },
        "model": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]+$"
        },
        "domain": {
          "type": "array"
        },
        "minimum": {
          "type": "integer",
          "minimum": 1
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["record_exists", "record_count"]
              }
            }
          },
          "then": {
            "required": ["model", "domain"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "field_equals"
              }
            }
          },
          "then": {
            "required": ["model", "domain", "field", "value"]
          }
        }
      ]
    }
  }
}