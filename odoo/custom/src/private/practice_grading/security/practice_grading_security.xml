<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_practice_grading" model="ir.module.category">
        <field name="name">Practice Grading</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_practice_grading" model="res.groups.privilege">
        <field name="name">Practice Grading</field>
        <field name="category_id" ref="module_category_practice_grading" />
    </record>

    <record id="group_practice_grading_reviewer" model="res.groups">
        <field name="name">Practice Grading Reviewer</field>
        <field name="privilege_id" ref="privilege_practice_grading" />
    </record>

    <record id="group_practice_grading_manager" model="res.groups">
        <field name="name">Practice Grading Manager</field>
        <field name="privilege_id" ref="privilege_practice_grading" />
        <field
            name="implied_ids"
            eval="[(4, ref('practice_grading.group_practice_grading_reviewer'))]"
        />
    </record>

    <record id="group_practice_grading_student" model="res.groups">
        <field name="name">Practice Grading Student</field>
        <field name="privilege_id" ref="privilege_practice_grading" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="rule_practice_grading_run_student" model="ir.rule">
        <field name="name">Students: published evaluations for their companies</field>
        <field name="model_id" ref="model_practice_grading_run" />
        <field name="groups" eval="[(4, ref('group_practice_grading_student'))]" />
        <field name="domain_force">[('publication_state', '=', 'published'), ('company_ids', 'in', user.company_ids.ids)]</field>
    </record>

    <record id="rule_practice_grading_result_student" model="ir.rule">
        <field name="name">Students: results for their published evaluations</field>
        <field name="model_id" ref="model_practice_grading_result" />
        <field name="groups" eval="[(4, ref('group_practice_grading_student'))]" />
        <field name="domain_force">[('run_id.publication_state', '=', 'published'), ('company_id', 'in', user.company_ids.ids)]</field>
    </record>
</odoo>