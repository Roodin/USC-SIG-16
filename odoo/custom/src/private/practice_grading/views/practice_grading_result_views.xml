<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_practice_grading_result_search" model="ir.ui.view">
        <field name="name">practice.grading.result.search</field>
        <field name="model">practice.grading.result</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id" />
                <field name="student_identifier" />
                <field name="run_id" />
                <filter
                    name="group_by_company"
                    string="Student"
                    context="{'group_by': 'company_id'}"
                />
                <filter
                    name="group_by_run"
                    string="Grading Run"
                    context="{'group_by': 'run_id'}"
                />
            </search>
        </field>
    </record>

    <record id="view_practice_grading_result_list" model="ir.ui.view">
        <field name="name">practice.grading.result.list</field>
        <field name="model">practice.grading.result</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="run_id" />
                <field name="company_id" />
                <field name="student_identifier" optional="show" />
                <field name="criterion_id" />
                <field name="status" />
                <field name="weight" sum="Total weight" />
                <field name="automatic_points" sum="Automatic points" />
                <field name="manual_points" readonly="status != 'manual_review'" />
                <field name="awarded_points" sum="Final score" />
            </list>
        </field>
    </record>

    <record id="view_practice_grading_result_form" model="ir.ui.view">
        <field name="name">practice.grading.result.form</field>
        <field name="model">practice.grading.result</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="run_id" />
                            <field name="company_id" />
                            <field name="student_identifier" />
                            <field name="criterion_id" />
                            <field name="status" />
                        </group>
                        <group>
                            <field name="weight" />
                            <field name="automatic_points" />
                            <field name="manual_points" readonly="status != 'manual_review'" />
                            <field name="awarded_points" />
                        </group>
                    </group>
                    <group>
                        <field name="review_note" readonly="status != 'manual_review'" />
                        <field name="evidence" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_practice_grading_result" model="ir.actions.act_window">
        <field name="name">Results</field>
        <field name="res_model">practice.grading.result</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_company': 1}</field>
    </record>

    <record id="view_practice_grading_export_wizard_form" model="ir.ui.view">
        <field name="name">practice.grading.export.wizard.form</field>
        <field name="model">practice.grading.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Grading Results">
                <group>
                    <field name="export_file" filename="export_filename" readonly="1" />
                    <field name="export_filename" invisible="1" />
                </group>
                <footer>
                    <button string="Close" special="cancel" class="btn-primary" />
                </footer>
            </form>
        </field>
    </record>

    <menuitem
        id="menu_practice_grading_result"
        name="Results"
        parent="menu_practice_grading_root"
        action="action_practice_grading_result"
        groups="practice_grading.group_practice_grading_reviewer,practice_grading.group_practice_grading_manager"
        sequence="40"
    />
</odoo>