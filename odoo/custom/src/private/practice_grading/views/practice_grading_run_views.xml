<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_practice_grading_run_list" model="ir.ui.view">
        <field name="name">practice.grading.run.list</field>
        <field name="model">practice.grading.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="rubric_id" />
                <field name="state" />
                <field name="publication_state" />
                <field name="started_at" />
                <field name="finished_at" />
                <field name="total_score" />
                <field name="total_weight" />
            </list>
        </field>
    </record>

    <record id="view_practice_grading_run_form" model="ir.ui.view">
        <field name="name">practice.grading.run.form</field>
        <field name="model">practice.grading.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_run"
                        string="Run Evaluation"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ['draft', 'done'] or locked"
                        groups="practice_grading.group_practice_grading_manager"
                    />
                    <button
                        name="action_lock"
                        string="Lock Evaluation"
                        type="object"
                        invisible="state != 'done' or locked"
                        groups="practice_grading.group_practice_grading_manager"
                    />
                    <button
                        name="action_publish"
                        string="Publish"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'done' or publication_state == 'published'"
                        groups="practice_grading.group_practice_grading_manager"
                    />
                    <button
                        name="action_unpublish"
                        string="Unpublish"
                        type="object"
                        invisible="publication_state != 'published'"
                        groups="practice_grading.group_practice_grading_manager"
                    />
                    <button
                        name="action_export_csv"
                        string="Export CSV"
                        type="object"
                        invisible="state != 'done'"
                    />
                    <button
                        name="action_view_results"
                        string="View Results"
                        type="object"
                        invisible="state != 'done'"
                    />
                    <button
                        name="action_view_student_grades"
                        string="Student Grades"
                        type="object"
                        invisible="state != 'done'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done" />
                    <field name="publication_state" invisible="state != 'done'" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="rubric_id" readonly="state != 'draft'" />
                            <field name="company_ids" widget="many2many_tags" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="started_at" />
                            <field name="finished_at" />
                            <field name="locked" />
                            <field name="total_score" />
                            <field name="total_weight" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Results">
                            <field name="result_ids" readonly="1">
                                <list>
                                    <field name="company_id" />
                                    <field name="student_identifier" />
                                    <field name="criterion_id" />
                                    <field name="status" />
                                    <field name="weight" sum="Total weight" />
                                    <field name="automatic_points" sum="Automatic points" />
                                    <field name="manual_points" readonly="status != 'manual_review'" />
                                    <field name="awarded_points" sum="Final score" />
                                </list>
                            </field>
                        </page>
                        <page string="Rubric Snapshot">
                            <field name="rubric_snapshot" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_practice_grading_run" model="ir.actions.act_window">
        <field name="name">Grading Runs</field>
        <field name="res_model">practice.grading.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_practice_grading_student_run_list" model="ir.ui.view">
        <field name="name">practice.grading.student.run.list</field>
        <field name="model">practice.grading.run</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name" />
                <field name="finished_at" />
                <button
                    name="action_view_my_results"
                    type="object"
                    icon="fa-list"
                    title="View Evaluation Criteria"
                />
            </list>
        </field>
    </record>

    <record id="view_practice_grading_student_run_form" model="ir.ui.view">
        <field name="name">practice.grading.student.run.form</field>
        <field name="model">practice.grading.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="finished_at" />
                    </group>
                    <button
                        name="action_view_my_results"
                        string="View Evaluation Criteria"
                        type="object"
                        class="btn-primary"
                    />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_practice_grading_student_run" model="ir.actions.act_window">
        <field name="name">My Evaluations</field>
        <field name="res_model">practice.grading.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_practice_grading_student_run_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_practice_grading_student_run_list" />
        <field name="act_window_id" ref="action_practice_grading_student_run" />
    </record>

    <record id="action_practice_grading_student_run_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_practice_grading_student_run_form" />
        <field name="act_window_id" ref="action_practice_grading_student_run" />
    </record>

    <menuitem
        id="menu_practice_grading_run"
        name="Grading Runs"
        parent="menu_practice_grading_root"
        action="action_practice_grading_run"
        groups="practice_grading.group_practice_grading_reviewer,practice_grading.group_practice_grading_manager"
        sequence="30"
    />
    <menuitem
        id="menu_practice_grading_student_run"
        name="My Evaluations"
        parent="menu_practice_grading_root"
        action="action_practice_grading_student_run"
        groups="practice_grading.group_practice_grading_student"
        sequence="30"
    />
</odoo>